{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!output/|assets/|favicon\\.svg|robots\\.txt|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
